NODE_ENV=development
HOST=0.0.0.0
PORT=8080
HOST_PORT=80
MCP_PATH=/mcp
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1

# REQUIRED: Set to false only for local debugging without OAuth.
AUTH_REQUIRED=true
# REQUIRED: Fill from Auth0 > Applications/APIs.
AUTH0_ISSUER=https://YOUR_TENANT.us.auth0.com/
# REQUIRED: Stable Auth0 API Identifier (do not tie to EC2/IP).
AUTH0_AUDIENCE=https://kev-ops-mcp-api/mcp
# OPTIONAL: Extra accepted audiences during migrations (comma-separated).
AUTH0_AUDIENCE_ALIASES=
# OPTIONAL: OAuth protected resource identifier advertised in PRM. Defaults to AUTH0_AUDIENCE.
AUTH0_RESOURCE=https://kev-ops-mcp-api/mcp
# REQUIRED: Usually https://<tenant>.us.auth0.com/.well-known/jwks.json
AUTH0_JWKS_URI=https://YOUR_TENANT.us.auth0.com/.well-known/jwks.json
AUTH0_TIER_CLAIM=https://kevops.example.com/tier
AUTH0_ROLES_CLAIM=https://kevops.example.com/roles
AUTH0_DEFAULT_TIER=free
AUTH_REQUIRED_SCOPES=mcp:tools

# Optional Redis (recommended for production)
REDIS_URL=redis://redis:6379
REDIS_PREFIX=kevops

# Per-tier request caps (calls/hour)
RATE_LIMIT_FREE_HOURLY=30
RATE_LIMIT_PREMIUM_HOURLY=150
RATE_LIMIT_ANALYST_HOURLY=500

# Cache policy
CACHE_NVD_TTL_SEC=3600
CACHE_NVD_STALE_SEC=86400
CACHE_KEV_TTL_SEC=1800
CACHE_KEV_STALE_SEC=86400
CACHE_EPSS_TTL_SEC=86400
CACHE_EPSS_STALE_SEC=604800
CACHE_OSV_TTL_SEC=43200
CACHE_OSV_STALE_SEC=259200

# OSV query tuning for lockfile scans
OSV_QUERY_URL=https://api.osv.dev/v1/query
OSV_QUERY_BATCH_URL=https://api.osv.dev/v1/querybatch
OSV_QUERY_TIMEOUT_MS=20000
OSV_QUERY_BATCH_TIMEOUT_MS=30000
OSV_BATCH_CHUNK_SIZE=40
OSV_BATCH_CONCURRENCY=4
OSV_BATCH_FALLBACK_CONCURRENCY=6
OSV_MAX_PAGES_PER_QUERY=4

# Optional NVD API key (improves upstream limits)
NVD_API_KEY=

LOG_LEVEL=info
