aws_region         = "us-east-1"
project_name       = "kevops-mcp"
creator            = "ganesh"
purpose            = "kd-ai-league"
instance_type      = "t3a.micro"
root_volume_size_gb = 12

# Optional if you want SSH
# key_name = "your-ec2-keypair-name"
ssh_cidr_blocks = ["0.0.0.0/0"]

# Push this repo to GitHub (or another git host) and set URL + ref.
repo_url = "https://github.com/<your-user>/<your-repo>.git" # REQUIRED
repo_ref = "main"

# Keep 80 for easier access in demos.
host_port = 80

# Optional custom domain. If empty, the server uses <public-ip>.nip.io.
app_domain = ""

auth_required = true
auth0_issuer  = "https://YOUR_TENANT.us.auth0.com/" # REQUIRED
auth0_audience = "https://kev-ops-mcp-api" # REQUIRED (must match Auth0 API Identifier exactly)
auth0_jwks_uri = "https://YOUR_TENANT.us.auth0.com/.well-known/jwks.json" # REQUIRED

auth0_tier_claim   = "https://kevops.example.com/tier"
auth0_roles_claim  = "https://kevops.example.com/roles"
auth0_default_tier = "free"
auth_required_scopes_csv = "mcp:tools"

# Optional
nvd_api_key = ""
log_level   = "info"
